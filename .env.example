# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Customer Service Target Email
CUSTOMER_SERVICE_EMAIL="enquiry@sghollyglobe.com"

# Resend API Key
RESEND_API_KEY=

# Optional Custom Sender Email (Required if sending to external domains like enquiry@sghollyglobe.com)
# Default for trial mode is: onboarding@resend.dev (Only sends to your registered Resend account email)
# Once your domain is verified at https://resend.com/domains, set this to your verified sender address:
RESEND_FROM_EMAIL="HollyGlobe Singapore <enquiry@sghollyglobe.com>"

# Optional override for the inquiry recipient (defaults to CUSTOMER_SERVICE_EMAIL)
RESEND_TO_EMAIL=

# Strict citation workflow backend
# HG_BRAND_CITATION_SCRIPT: absolute path to hg-brand-citation.py
# HG_BRAND_CITATION_WORKDIR: writable dir where each run creates a temp folder
HG_BRAND_CITATION_SCRIPT=
HG_BRAND_CITATION_WORKDIR=
HG_BRAND_CITATION_TIMEOUT_MS=120000

# PERPLEXITY_API_KEY: REQUIRED for /api/perplexity-citation.
# The Python workflow reads this env var (declared as provider_api_key_env) and
# aborts with an EnvironmentError if it is missing. No key = no citation report.
PERPLEXITY_API_KEY=
